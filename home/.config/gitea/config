# omarchy-gitea configuration, sourced as shell. Defaults live in the script;
# anything set here wins.

# The shop Gitea's origin: the forge on the tailnet, by address because that
# is the server's own ROOT_URL, so every link it hands back matches.
GITEA_URL="http://100.64.0.1:3000"

# Read token: the tracker's own, scoped read:repository + read:user +
# read:organization (without the last, org repo listing fails). The server
# refuses it any write, so the bar holds nothing worth stealing.
GITEA_TOKEN_FILE="$HOME/.config/gitea-mcp/token-dev-box-0-readonly"

# Explicit tracking list (space-separated owner/repo). Unset means every
# unarchived repo the token can push to, rediscovered on each poll.
#GITEA_REPOS="nmc/server-systems"

# The monorepo. Listed first everywhere; the panel opens focused on its
# current run unless another repo is in flight or failing.
GITEA_PRIMARY="nmc/server-systems"
