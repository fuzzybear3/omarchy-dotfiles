#!/usr/bin/env bash
# omarchy-tasks — the Omarchy companion of the platform's personal tasks
# service (server-systems, apps/tasks). Self-contained on purpose: curl + jq
# against the HTTP API, so the dotfiles need no compiled client and nothing
# built elsewhere (its design §6; the `tasks` CLI still exists server-side).
#
#   omarchy-tasks login     OIDC device flow → ~/.config/tasks/token (0600)
#   omarchy-tasks capture   one-line quick capture (gum prompt → POST)
#   omarchy-tasks count     open-task count (stack depth), for the bar face
#   omarchy-tasks panel     {date, stack[], folders[]} JSON, for the panel
#   omarchy-tasks add [-t F] T   push task T, optionally into folder F
#   omarchy-tasks done N V  mark task N done, under the version V read
#   omarchy-tasks today     the today view, readable
#   omarchy-tasks open      the web interface (once it exists)
#
# Exit codes for `count` and `panel` (the shell service keys off them):
# 0 with the payload on stdout; 3 not logged in; 2 unreachable/refused.
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tasks"
TOKEN_FILE="$CONFIG_DIR/token"
CONFIG_FILE="$CONFIG_DIR/config"

# The stack's canonical origin; ~/.config/tasks/config overrides (TASKS_URL=…).
TASKS_URL="https://tasks.nmc.internal"
# shellcheck source=/dev/null
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"
TASKS_URL="${TASKS_URL%/}"

token() { [ -f "$TOKEN_FILE" ] && tr -d '[:space:]' < "$TOKEN_FILE" || true; }

# One API call: api METHOD PATH [JSON_BODY]. Body on stdout; curl's --fail
# keeps refusals as nonzero exits (the envelope is lost, which is fine for a
# companion this size — the CLI in the service repo is the forensic tool).
api() {
    local method="$1" path="$2" body="${3:-}"
    local args=(-sS --fail -m 10 -X "$method" -H "Authorization: Bearer $(token)")
    [ -n "$body" ] && args+=(-H "Content-Type: application/json" -d "$body")
    curl "${args[@]}" "$TASKS_URL$path"
}

# The login runs headless from the bar widget's button, so every outcome —
# not just success — must reach the user as a notification.
login_fail() {
    echo "login failed: $1" >&2
    notify-send -u critical -a Tasks "Login failed" "$1" 2>/dev/null || true
    exit 1
}

login() {
    local device_config issuer client_id discovery device grant
    # One login at a time across the whole desktop: the bar runs one widget
    # instance per monitor (the gitea tracker's flock precedent, its `check`),
    # so two clicks can start two device flows — two browser tabs, doubled
    # notifications, and the second token clobbering the first. Unlike a quick
    # check cycle there is nothing to wait out here — a login runs for however
    # long the browser approval takes — so the loser doesn't queue: it points
    # at the flow already underway and leaves.
    mkdir -p "$CONFIG_DIR"
    exec 9>>"$TOKEN_FILE.lock"
    if ! flock -n 9; then
        echo "a login is already in progress" >&2
        notify-send -a Tasks "Login already in progress" \
            "Approve the request in the browser tab that is already open" 2>/dev/null || true
        exit 1
    fi
    device_config=$(curl -sS --fail -m 10 "$TASKS_URL/auth/device-config") \
        || login_fail "could not reach $TASKS_URL — is the service deployed, and are you on the tailnet?"
    issuer=$(jq -re .issuer <<<"$device_config") \
        || login_fail "the server published no OIDC issuer"
    client_id=$(jq -re .client_id <<<"$device_config")

    discovery=$(curl -sS --fail -m 10 "${issuer%/}/.well-known/openid-configuration") \
        || login_fail "could not fetch the issuer's discovery document from $issuer"
    local device_ep token_ep
    device_ep=$(jq -re .device_authorization_endpoint <<<"$discovery") \
        || login_fail "the issuer offers no device flow (is blueprint 21's brand flow applied?)"
    token_ep=$(jq -re .token_endpoint <<<"$discovery")

    # --data-urlencode throughout: Authentik's device codes carry raw '+' and
    # '#', and curl -d does NOT encode — a '+' arrives as a space, the server
    # sees a code that matches nothing, and every poll answers invalid_grant.
    grant=$(curl -sS --fail -X POST "$device_ep" \
        --data-urlencode "client_id=$client_id" \
        --data-urlencode "scope=openid profile tasks") \
        || login_fail "the device authorization was refused (client $client_id)"
    local user_code verify_url interval expires device_code
    device_code=$(jq -re .device_code <<<"$grant") \
        || login_fail "malformed device authorization response"
    user_code=$(jq -re .user_code <<<"$grant")
    verify_url=$(jq -re '.verification_uri_complete // .verification_uri' <<<"$grant")
    interval=$(jq -r '.interval // 5' <<<"$grant")
    expires=$(jq -r '.expires_in // 600' <<<"$grant")

    echo "Approve the request in your browser (code: $user_code)"
    echo "  $verify_url"
    notify-send -a Tasks "Approve the login" \
        "A browser tab is opening (code $user_code)" 2>/dev/null || true
    setsid xdg-open "$verify_url" >/dev/null 2>&1 || true

    local deadline=$((SECONDS + expires)) response error
    while [ "$SECONDS" -lt "$deadline" ]; do
        sleep "$interval"
        response=$(curl -sS -X POST "$token_ep" \
            -d "grant_type=urn:ietf:params:oauth:grant-type:device_code" \
            --data-urlencode "device_code=$device_code" \
            --data-urlencode "client_id=$client_id")
        if jq -e .access_token >/dev/null 2>&1 <<<"$response"; then
            mkdir -p "$CONFIG_DIR"
            (umask 077 && jq -rj .access_token <<<"$response" > "$TOKEN_FILE")
            echo "Logged in; token written to $TOKEN_FILE"
            notify-send -a Tasks "Logged in" "Personal tasks is connected" 2>/dev/null || true
            # Readable for a beat when this ran in a floating terminal that
            # closes on exit (the widget's login button).
            sleep 2
            return 0
        fi
        error=$(jq -r '.error // "unknown"' <<<"$response")
        case "$error" in
            authorization_pending) ;;
            slow_down) interval=$((interval + 5)) ;;
            access_denied) login_fail "the request was denied in the browser" ;;
            expired_token) login_fail "the code expired before approval" ;;
            *) login_fail "the token endpoint refused: $error" ;;
        esac
    done
    login_fail "the code expired before approval"
}

capture() {
    local title doc
    # Escape closes the prompt without a task; so does an empty line.
    title=$(gum input --placeholder "New task…" --prompt "☑ " || true)
    [ -z "$title" ] && exit 0
    doc=$(jq -cn --arg title "$title" '{title: $title, status: "open"}')
    if api POST /api/tasks "$doc" >/dev/null; then
        notify-send -a Tasks "Task captured" "$title" 2>/dev/null || echo "captured: $title"
    else
        notify-send -u critical -a Tasks "Capture FAILED" "$title — run omarchy-tasks login?" \
            2>/dev/null || echo "capture failed" >&2
        # Leave the terminal open long enough to read the failure when run in
        # a floating window that closes on exit.
        sleep 3
        exit 1
    fi
}

# Stack depth: every open task, undated ones included — the tasks are a
# stack, not a calendar (decision 2026-09-02).
count() {
    [ -s "$TOKEN_FILE" ] || exit 3
    local response
    response=$(api GET "/api/tasks?today=$(date +%F)" 2>/dev/null) || exit 2
    jq -re '.tasks | length' <<<"$response" 2>/dev/null || exit 2
}

# The panel's one fetch: all open tasks, shaped as the stack (untagged,
# newest first — seq is creation order) plus one folder per first tag. Tasks
# carry seq/title/due/version — everything a row and its done-click need.
panel() {
    [ -s "$TOKEN_FILE" ] || exit 3
    local d response
    d=$(date +%F)
    response=$(api GET "/api/tasks?today=$d" 2>/dev/null) || exit 2
    jq -cn --argjson all "$response" --arg d "$d" '
        ($all.tasks | sort_by(-.seq)) as $open
        | {date: $d,
           stack: [$open[] | select((.tags // []) | length == 0)],
           folders: ([$open[] | select((.tags // []) | length > 0)]
             | group_by(.tags[0])
             | map({name: .[0].tags[0], tasks: .})
             | sort_by(.name))}' || exit 2
}

# Promptless create, for the panel's inline capture row. -t files the task
# into a folder (a tag, the server's vocabulary).
add() {
    local tag=""
    if [ "${1:-}" = "-t" ]; then
        tag="${2:-}"
        shift 2 || true
    fi
    local title="${1:-}"
    [ -n "$title" ] || { echo "usage: omarchy-tasks add [-t folder] <title>" >&2; exit 2; }
    local doc
    if [ -n "$tag" ]; then
        doc=$(jq -cn --arg title "$title" --arg tag "$tag" \
            '{title: $title, status: "open", tags: [$tag]}')
    else
        doc=$(jq -cn --arg title "$title" '{title: $title, status: "open"}')
    fi
    api POST /api/tasks "$doc" >/dev/null || exit 2
}

# `done` is a shell keyword, hence the function name.
done_task() {
    local seq="${1:-}" version="${2:-}"
    [ -n "$seq" ] && [ -n "$version" ] \
        || { echo "usage: omarchy-tasks done <seq> <version>" >&2; exit 2; }
    local doc
    doc=$(jq -cn --argjson v "$version" '{status: "done", expected_version: $v}')
    api POST "/api/tasks/$seq/status" "$doc" >/dev/null || exit 2
}

today() {
    api GET "/api/tasks?view=today&today=$(date +%F)" \
        | jq -r '.tasks[] | "\(.seq)\t\(.due // "")\t\(.title)"'
}

case "${1:-}" in
    login) login ;;
    capture) capture ;;
    count) count ;;
    panel) panel ;;
    add) shift; add "$@" ;;
    done) shift; done_task "$@" ;;
    today) today ;;
    open) exec xdg-open "$TASKS_URL" ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
